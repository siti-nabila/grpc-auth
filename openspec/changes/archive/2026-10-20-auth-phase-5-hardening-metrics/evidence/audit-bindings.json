    },
    {
      "source": "internal/configs/lifecycle.go",
      "repositories": "authfeature.LogoutRepositories",
      "binder": "authfeature.BindLogoutRepositories",
      "observer": "required-write; common.ObserveAudit; original error/panic preserved"
    },
    {
      "source": "internal/configs/lifecycle.go",
      "repositories": "authfeature.PasswordRepositories",
      "binder": "authfeature.BindPasswordRepositories",
      "observer": "required-write; common.ObserveAudit; original error/panic preserved"
    },
    {
      "source": "internal/configs/lifecycle.go",
